# ---- SupplyChainIQ environment -------------------------------------------------
# Copy this file to backend/.env and adjust as needed. Every value has a working
# default for local demo runs — the app runs with no .env at all.

# Primary database (PostgreSQL via docker compose). When unreachable the backend
# transparently falls back to SQLite (SQLITE_FALLBACK_URL) so the demo always runs.
DATABASE_URL=postgresql+psycopg2://supplyiq:supplyiq@localhost:5433/supplychainiq

# SQLite fallback used when PostgreSQL is unreachable (also handy for quick demos).
SQLITE_FALLBACK_URL=sqlite:///./supplychainiq.db

# Echo SQL statements (debugging only).
DB_ECHO=false

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Demo token signing secret. CHANGE THIS for anything beyond local demos.
TOKEN_SECRET=supplychainiq-demo-secret-change-me
TOKEN_EXPIRE_MINUTES=720

# Default business assumptions (also editable at runtime via Settings -> /api/settings).
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_ORDERING_COST=500
DEFAULT_HOLDING_COST_RATE=0.20
DEFAULT_DEMAND_WINDOW_DAYS=90
DEFAULT_FORECAST_DAYS=30
